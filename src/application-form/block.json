{
  "apiVersion": 3,
  "name": "minc-hiring/application-form",
  "title": "Hiring Application Form",
  "description": "Display an application form for an open job.",
  "category": "widgets",
  "attributes": {
    "jobId": {
      "type": "number",
      "default": 0
    },
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "supports": {
    "align": ["wide", "full"]
  },
  "textdomain": "minc-hiring",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
